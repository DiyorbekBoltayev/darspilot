# Nusxa oling:  copy .env.example .env   va kalitni kiriting. Kalitsiz ilova shablon matnlar bilan ishlaydi.
OPENAI_API_KEY=
# Masala matni, sinf xulosasi va dars ssenariysi uchun (sifat muhim)
OPENAI_MODEL=gpt-5.6-terra
# Ko'p o'quvchiga feedback yozish uchun (arzonroq, tezroq)
OPENAI_MODEL_FAST=gpt-5.6-luna
# Qo'lyozma yechim va mashq daftarini suratdan baholash (tez model tavsiya etiladi: ~5 s, terra ~100 s)
OPENAI_MODEL_VISION=gpt-5.6-luna
OPENAI_TIMEOUT=120
# Fikrlash darajasi: minimal / low / medium / high (bo'sh — model standarti). low — demo uchun tezroq.
OPENAI_REASONING_EFFORT=low

# Docker portlari (band bo'lsa o'zgartiring)
WEB_PORT=8080
MINIO_CONSOLE_PORT=9101
